# DEMO / MVP MODIFICABLE. No incluye credenciales reales.
# NEXT_PUBLIC_* es visible en el navegador: nunca colocar secretos.
NEXT_PUBLIC_STORE_NAME=Mercado Cercano
NEXT_PUBLIC_STORE_SHORT_NAME=Cercano
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_SUPPORT_PHONE=
NEXT_PUBLIC_DEMO_MODE=false
NEXT_PUBLIC_ENABLE_GOOGLE_AUTH=false

# Solo el MVP conectado necesita Supabase. La demo local no usa estas claves.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Privilegiada y exclusivamente del servidor; nunca NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Herramientas de migracion/alta, no son datos publicos del frontend.
DATABASE_URL=
ADMIN_EMAIL=

# Mantenimiento: no hay cron activado. Secreto minimo 32 caracteres.
CRON_SECRET=
# Correo opcional de pedidos. Auth SMTP se configura en Supabase por separado.
RESEND_API_KEY=
EMAIL_FROM=

# Opcionales solo para desarrollo (valores por defecto en scripts/dev-demo.mjs):
# PORT=3000
# DEMO_DATA_DIR=.workbuddy-ai/demo-local

# Configuracion comercial mediante administracion, no secretos en este archivo:
# tasa actual, horarios/cupos, cobertura/minimos e instrucciones de pago.
# En Supabase, efectivo/PagoMovil/transfer empiezan deshabilitados.
# Tarjetas, Prime, Zelle y recargas no forman parte de esta version.
# Guia completa: docs/ENTORNO-Y-VERCEL.md
